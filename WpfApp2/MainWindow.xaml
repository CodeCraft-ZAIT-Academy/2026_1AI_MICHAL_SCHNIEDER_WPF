<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF6FBB32" Offset="1"/>
                <GradientStop Color="#FF2B94B7" Offset="0.245"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Meno:" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="371,65,0,0" VerticalAlignment="Top" Background="#FF7DC31E"/>
        <Label Content="Priezvisko:" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="361,168,0,0" VerticalAlignment="Top" Background="#FF81C314"/>
        <DatePicker x:Name="Datum" HorizontalAlignment="Left" Margin="332,279,0,0" VerticalAlignment="Top" Grid.Column="1" Height="35" Width="122" Background="#FF7AE8FD"/>
        <Label Content="Datum:" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="369,248,0,0" VerticalAlignment="Top" Background="#FF42C5C8"/>
        <Button x:Name="Button" Content="KLIKNI SEM" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="317,333,0,0" VerticalAlignment="Top" Height="69" Width="144" Click="Button_Click" Background="#FF2BCED2" FontSize="25"/>
        <TextBox x:Name="Meno" HorizontalAlignment="Left" Margin="333,96,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.Column="1" Height="35" Background="#FF21EF25"/>
        <TextBox x:Name="Priezvisko" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" Grid.Column="1" Height="37" Margin="333,0,0,0" Background="#FF2DDE14" TextChanged="Priezvisko_TextChanged"/>
        <Image Grid.ColumnSpan="2" Margin="466,273,138,8" Source="https://petrasimkova.cz/wp-content/uploads/2016/10/sipka-vlevo-cervena.png"/>
        <Image Grid.ColumnSpan="2" Margin="118,267,492,14" Source="https://petrasimkova.cz/wp-content/uploads/2016/10/sipka-vlevo-cervena.png" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

    </Grid>
</Window>
